# Copy this file to .env. Never commit real API keys.
# Stage 2 fixed policy: research/paper only, long-only, no leverage or short selling.
AI_TRADE_MODE=paper
AI_MARKET=US_EQUITY
AI_BAR_INTERVAL=1d
AI_STRATEGY_STYLE=swing
AI_LONG_ONLY=true
AI_ALLOW_LEVERAGE=false
AI_ALLOW_SHORT=false

# Model objective: predict at least 1% gross return within 5 daily bars.
AI_PREDICTION_HORIZON=5
AI_TARGET_RETURN=0.01
AI_BUY_THRESHOLD=0.60
AI_SELL_THRESHOLD=0.45
AI_MAX_HOLDING_BARS=10

# Portfolio and loss policy.
AI_MAX_POSITIONS=3
AI_MAX_POSITION_FRACTION=0.20
AI_MINIMUM_CASH_FRACTION=0.30
AI_STOP_LOSS=0.03
AI_TAKE_PROFIT=0.06
AI_MAX_DAILY_LOSS=0.02
AI_MAX_WEEKLY_LOSS=0.05
AI_MAX_DRAWDOWN_LIMIT=0.10
AI_MAX_CONSECUTIVE_LOSSES=3

# Backtest assumptions.
AI_FEE_RATE=0.0005
AI_SLIPPAGE_RATE=0.0005
AI_INITIAL_CASH=10000000
AI_RANDOM_STATE=42

# Future broker integration placeholders. Keep empty until the paper-trading stage.
BROKER_NAME=paper
BROKER_API_KEY=
BROKER_API_SECRET=
